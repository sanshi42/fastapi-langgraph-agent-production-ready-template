# 环境配置示例

# 应用设置
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DESCRIPTION="用于进行开发实践的 LangGraph 代码"
DEBUG=true

# API 设置
API_V1_STR=/api/v1

# CORS 设置
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse 设置
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM 设置
OPENAI_API_KEY="your-llm-api-key" # 例如 OpenAI API key
DEFAULT_LLM_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://provider.example.com/v1
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# 长期记忆设置
LONG_TERM_MEMORY_ENABLED=true
# LONG_TERM_MEMORY_LLM_PROVIDER=openai
# LONG_TERM_MEMORY_MODEL=${DEFAULT_LLM_MODEL}
# LONG_TERM_MEMORY_BASE_URL=${OPENAI_BASE_URL}
# LONG_TERM_MEMORY_EMBEDDER_PROVIDER=openai
# LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
# LONG_TERM_MEMORY_EMBEDDER_BASE_URL=${OPENAI_BASE_URL}

# Agent Runtime 设置
AGENT_WORKSPACE_ROOT=/app
AGENT_MAX_OUTPUT_CHARS=100000
AGENT_TOOL_APPROVAL_ENABLED=true
AGENT_WORKER_ENABLED=true
AGENT_JOB_LEASE_SECONDS=60
# AGENT_MCP_CONFIG_PATH=/app/mcp.json
# AGENT_SKILLS_DIR=/app/skills
# AGENT_PROJECT_MEMORY_DIR=/app/.memory

# JWT 设置
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# 数据库设置
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# 限流设置
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# 性能分析设置
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# 日志设置
LOG_LEVEL=DEBUG
LOG_FORMAT=console
